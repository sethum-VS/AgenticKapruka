# AgenticKapruka — environment variables
# Copy to .env for local development:  cp .env.example .env
# Never commit .env (real secrets). This file uses placeholders only.
#
# ── Local development ─────────────────────────────────────────────────────────
# Run Redis Stack locally (RediSearch required for LangGraph checkpointer):
#   docker run -d -p 6379:6379 redis/redis-stack-server:latest
# Neo4j AuraDB, Zep Cloud, and NVIDIA API keys come from their
# respective consoles.

# ── Redis (Memorystore / local) ───────────────────────────────────────────────
# Required. Session cache, rate limits, LangGraph checkpointer, cart state.
# Local: redis://localhost:6379/0
# Memorystore (private IP, via VPC connector): rediss://10.x.x.x:6378/0
REDIS_URL=redis://localhost:6379/0

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────────
# Required. GraphRAG ontology and vector search. Create a free Aura instance at
# https://neo4j.com/cloud/aura/ and copy the connection URI and credentials.
NEO4J_URI=bolt+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Zep Cloud ─────────────────────────────────────────────────────────────────
# Required. Long-term conversational memory across sessions.
# https://www.getzep.com/
ZEP_API_KEY=your-zep-api-key

# ── NVIDIA NIM Configuration ─────────────────────────────────────────────────
# Required. Sign up at https://build.nvidia.com and generate an API key.
# Free tier: ~40 RPM (model-dependent, traffic-dependent). For production,
# self-host NIMs or use NVIDIA AI Enterprise.
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
# Optional. Used automatically when the primary key returns 429 rate limits.
# NVIDIA_API_KEY_BACKUP=nvapi-your-backup-nvidia-api-key

# Base URL for NVIDIA NIM OpenAI-compatible endpoints (default shown).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# LLM model for all text generation (chat, intent, rewrite, structured output).
# NVIDIA_LLM_MODEL=z-ai/glm-5.2

# Embedding model for GraphRAG ontology and query vectors (4096 dimensions).
# NVIDIA_EMBEDDING_MODEL=nvidia/nv-embed-v1

# Proactive rate limiter to stay under free-tier limits.
# NVIDIA_RATE_LIMIT_RPM=30

# Minimum cosine similarity for nv-embed-v1 vector matches.
# Tune via evals/ragas_eval.py after re-indexing with the new model.
# NVIDIA_VECTOR_THRESHOLD=0.75

# ── Kapruka MCP ───────────────────────────────────────────────────────────────
# Optional. Public Kapruka MCP JSON-RPC endpoint (default shown).
KAPRUKA_MCP_URL=https://mcp.kapruka.com/mcp

# ── GraphRAG reranker ─────────────────────────────────────────────────────────
# Minimum cross-encoder relevance score (0–1) to keep Occasion/Category nodes
# after traversal and to select hints.category / hints.occasion.
RERANKER_THRESHOLD=0.45

# ── Local debugging ───────────────────────────────────────────────────────────
# DEBUG_TRACE=1 prints structured pipeline blocks (CHAT TURN, NODE, ROUTE) to
# `make logs` / .dev/backend.log. Set DEBUG_TRACE=0 to silence those blocks.
# LOG_LEVEL=INFO is the default: app + trace output without HTTP/SDK noise.
# Use LOG_LEVEL=DEBUG only when you need extra lib/graphs debug lines.
APP_ENV=development
DEBUG_TRACE=1
LOG_LEVEL=INFO

# ── Application security ──────────────────────────────────────────────────────
# Required. Signs session cookies; minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters
